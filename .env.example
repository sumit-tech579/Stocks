# =============================================================================
# TradeNest - Frontend Environment Variables Template
# =============================================================================
# Copy this file to .env locally or paste these variables into your hosting
# provider's environment variables dashboard (e.g. Vercel, Firebase Hosting).
#
# IMPORTANT SECURITY NOTE:
# Only client-side SDK variables (prefixed with VITE_) are included here.
# NEVER include Firebase Admin credentials, private keys, or service-account
# JSON files in frontend code or client-facing repositories.
# =============================================================================

# Firebase Modular SDK Configuration
# Obtain these from: Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=tradenest-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tradenest-example
VITE_FIREBASE_STORAGE_BUCKET=tradenest-example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
