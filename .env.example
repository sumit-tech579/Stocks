# =============================================================================
# TradeNest - Environment Variables Template
# =============================================================================
# Copy this file to .env locally or configure these variables in your deployment
# environment (e.g. Firebase Cloud Functions, Railway, Render, Vercel).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Obtain these from: Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=tradenest-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tradenest-example
VITE_FIREBASE_STORAGE_BUCKET=tradenest-example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------------------
# 2. Backend Authentication Service Configuration (Node / Express)
# -----------------------------------------------------------------------------
PORT=3001
CODE_HMAC_SECRET=your_super_secret_hmac_key_for_otp_challenges

# Transactional Email (SMTP Configuration)
# Works with any standard SMTP provider (Gmail App Password, Resend, Brevo, SendGrid, AWS SES)
# Note: In development, if SMTP is unset, codes are safely displayed in the server terminal console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="TradeNest <your_email@gmail.com>"

# Optional: Firebase Admin Service Account Credentials
# Path to service account JSON file, or inline JSON string
# If omitted, Firebase Admin falls back to Application Default Credentials (ADC) or Project ID
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
