# =============================================================================
# TradeNest - Environment Variables Template
# =============================================================================
# Copy this file to .env locally or configure these variables in your deployment
# environment (Firebase Cloud Functions, Cloud Run, VPS, etc.).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Obtain these from: Firebase Console > Project Settings > General > Your Apps > Web App
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=tradenest-example.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tradenest-example
VITE_FIREBASE_STORAGE_BUCKET=tradenest-example.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# -----------------------------------------------------------------------------
# 2. Backend Security & OTP Secret
# -----------------------------------------------------------------------------
PORT=3001
CODE_HMAC_SECRET=your_super_secret_hmac_key_for_otp_challenges

# -----------------------------------------------------------------------------
# 3. Transactional Email Provider (Choose Option A or Option B)
# -----------------------------------------------------------------------------
# OPTION A: Resend API (Recommended - simple 1-minute setup, HTTPS REST, no SMTP blocks)
# 1. Sign up at https://resend.com
# 2. Generate an API Key (re_...)
# 3. For testing, use "onboarding@resend.dev" as EMAIL_FROM_ADDRESS
EMAIL_PROVIDER_API_KEY=re_1234567890abcdef
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME="TradeNest Security"

# OPTION B: SMTP (Gmail App Password, Brevo, SendGrid, Amazon SES)
# If EMAIL_PROVIDER_API_KEY is not set, the mailer uses standard SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="TradeNest Security <your_email@gmail.com>"

# -----------------------------------------------------------------------------
# 4. Optional: Firebase Admin Service Account Credentials
# -----------------------------------------------------------------------------
# If deploying to Firebase Cloud Functions or Google Cloud, this is auto-detected!
# For local Node server development outside Google Cloud:
# Path to service account JSON file, or inline JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
